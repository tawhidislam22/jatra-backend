model ServiceRequest {
  id               String        @id @default(uuid())
  serviceType      ServiceType   @default(WORKSHOP)
  serviceName      String?       // Specific package e.g. "Engine Repair", "Oil Change", etc.
  scheduledDate    DateTime
  issueDescription String?       // Optional customer notes
  problemImages    String[]      // Mandatory: at least one uploaded photo showing issue
  completionImages String[]      // Mandatory on mechanic completion: at least one photo
  reworkNotes      String?       // Owner notes if rework is requested
  estimatedDuration Int          @default(60) // Duration in minutes
  totalAmount      Float         @default(0)  // Total service price
  status           RequestStatus @default(PENDING)
  approvedAt       DateTime?
  cancellationFee  Float?
  refundAmount     Float?
  cancelledAt      DateTime?
  cancellationReason String?

  // Relations
  customerId String
  customer   User             @relation("CustomerServices", fields: [customerId], references: [id])
  vehicleId  String
  vehicle    Vehicle          @relation(fields: [vehicleId], references: [id])
  centerId   String
  center     AutomotiveCenter @relation(fields: [centerId], references: [id])
  mechanicId String?
  mechanic   User?            @relation("MechanicServices", fields: [mechanicId], references: [id])
  payment    Payment?
  review     Review?
  conversations Conversation[]
  assignmentHistory ServiceAssignmentHistory[]
  cancellationRecord CancellationRecord?
  walletTransactions WalletTransaction[]
  emailLogs    EmailLog[]

  @@index([customerId])
  @@index([centerId])
  @@index([mechanicId])
  @@index([vehicleId])
  @@index([status])
  @@index([scheduledDate])
}
