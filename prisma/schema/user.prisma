model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  name               String
  fullName           String?
  phone              String?
  role               Role       @default(CUSTOMER)
  status             UserStatus @default(ACTIVE)
  emailVerified      Boolean    @default(false)
  needPasswordChange Boolean    @default(false)
  isDeleted          Boolean    @default(false)
  deletedAt          DateTime?
  image              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // better-auth Relations
  sessions Session[]
  accounts Account[]

  // Vehicle System Relations
  ownedVehicles       Vehicle[]             @relation("CustomerVehicles")
  rentalBookings      RentalBooking[]
  serviceRequests     ServiceRequest[]      @relation("CustomerServices")
  assignedServices    ServiceRequest[]      @relation("MechanicServices")
  payments            Payment[]
  reviews             Review[]
  wallet              Wallet?
  cancellations       CancellationRecord[]  @relation("UserCancellations")

  // Center Management & Employment
  managedCenters AutomotiveCenter[] @relation("CenterAdmin")

  employedAtCenterId String?
  employedAtCenter   AutomotiveCenter? @relation("CenterMechanics", fields: [employedAtCenterId], references: [id])
  isAvailable        Boolean           @default(true) // For mechanics availability status

  // Assignment History
  mechanicAssignments ServiceAssignmentHistory[] @relation("MechanicAssignmentHistory")
  createdAssignments  ServiceAssignmentHistory[] @relation("OwnerAssignmentHistory")

  // Communication & Notifications
  conversationsAsP1 Conversation[] @relation("ConversationParticipant1")
  conversationsAsP2 Conversation[] @relation("ConversationParticipant2")
  messages          Message[]
  notifications     Notification[]

  @@index([role])
  @@index([status])
  @@index([employedAtCenterId])
  @@index([role, status])
  @@map("user")
}
