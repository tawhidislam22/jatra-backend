model AutomotiveCenter {
  id        String @id @default(uuid())
  name      String
  address   String
  latitude        Float
  longitude       Float
  phone           String?
  description     String?
  rating          Float    @default(0)
  isApproved      Boolean  @default(false)
  servicesOffered String[]
  customServices  Json?
  images          String[]
  adminId         String

  // Relations
  admin     User   @relation("CenterAdmin", fields: [adminId], references: [id])
  mechanics User[] @relation("CenterMechanics") // Roster of hired mechanics

  rentalFleet       Vehicle[]             @relation("CenterFleet")
  serviceRequests   ServiceRequest[]
  reviews           Review[]
  conversations     Conversation[]
  wishlistItems     WishlistItem[]

  @@index([adminId])
  @@index([isApproved])
  @@index([rating])
  @@index([isApproved, rating(sort: Desc)])
}
