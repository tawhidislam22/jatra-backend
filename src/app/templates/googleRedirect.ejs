<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jatra - Redirecting to Google...</title>
    <style>
        body {
            margin: 0;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #0f172a; /* Slate 900 */
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #ffffff;
        }
        .container {
            text-align: center;
        }
        .logo {
            font-size: 36px;
            font-weight: 900;
            letter-spacing: 2px;
            margin-bottom: 20px;
            background: linear-gradient(to right, #3b82f6, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .spinner {
            width: 50px;
            height: 50px;
            border: 4px solid rgba(255,255,255,0.1);
            border-left-color: #3b82f6; /* Blue 500 */
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px auto;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        .text {
            font-size: 16px;
            color: #94a3b8; /* Slate 400 */
            font-weight: 500;
        }
        .error {
            color: #ef4444; /* Red 500 */
            margin-top: 20px;
            font-weight: 500;
        }
    </style>
</head>
<body>
    <div class="container" id="content-container">
        <div class="logo">JATRA</div>
        <div class="spinner"></div>
        <div class="text">Connecting to Google securely...</div>
    </div>
</body>
<script>
    (
        async () => {
            try {
                const response = await fetch("<%= betterAuthUrl %>/api/auth/sign-in/social", {
                    method : "POST",
                    headers : {
                        "Content-Type" : "application/json"
                    },
                    credentials : "include",
                    body: JSON.stringify({
                        provider : "google",
                        callbackURL: "<%= callbackURL %>"
                    })
                })

                const data = await response.json();

                if(data.url){
                    window.location.href = data.url
                }else{
                    document.getElementById('content-container').innerHTML = `
                        <div class="logo">JATRA</div>
                        <div class="error">Error connecting to Google. Please try again later.</div>
                    `;
                }
            } catch (error) {
                document.getElementById('content-container').innerHTML = `
                    <div class="logo">JATRA</div>
                    <div class="error">Error connecting to Google. Please try again later.<br><small style="color: #64748b;">${error.message}</small></div>
                `;
            }
        }
    )()
</script>
</html>