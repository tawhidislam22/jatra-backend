<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Invoice - Jatra</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f4f5; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; -webkit-font-smoothing: antialiased;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f4f4f5; padding: 40px 20px;">
        <tr>
            <td align="center">
                <table width="100%" max-width="650" cellpadding="0" cellspacing="0" border="0" style="max-width: 650px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);">
                    
                    <!-- Header -->
                    <tr>
                        <td style="background-color: #1e293b; padding: 40px 30px; text-align: center;">
                            <h1 style="color: #ffffff; margin: 0 0 5px 0; font-size: 32px; font-weight: 800; letter-spacing: 2px;">JATRA INVOICE</h1>
                            <p style="color: #94a3b8; margin: 0; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Payment Receipt & Booking Confirmation</p>
                        </td>
                    </tr>

                    <!-- Body Content -->
                    <tr>
                        <td style="padding: 40px 40px 20px 40px;">
                            <h2 style="margin: 0 0 20px 0; font-size: 18px; color: #0f172a; font-weight: 600;">Hello <%= customerName %>,</h2>
                            <p style="margin: 0 0 30px 0; font-size: 14px; color: #475569; line-height: 1.6;">
                                Your payment for your Jatra automotive service or rental has been successfully processed. Below is your official payment invoice for your records.
                            </p>

                            <!-- Invoice Details -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border-left: 4px solid #3b82f6; border-radius: 4px; margin-bottom: 30px;">
                                <tr>
                                    <td style="padding: 20px;">
                                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td style="padding-bottom: 12px; font-size: 14px; font-weight: 600; color: #0f172a; width: 40%;">Invoice ID:</td>
                                                <td align="right" style="padding-bottom: 12px; font-size: 14px; color: #475569; font-weight: 700;"><%= invoiceId %></td>
                                            </tr>
                                            <tr>
                                                <td style="padding-bottom: 12px; font-size: 14px; font-weight: 600; color: #0f172a;">Transaction ID:</td>
                                                <td align="right" style="padding-bottom: 12px; font-size: 14px; color: #475569;"><%= transactionId %></td>
                                            </tr>
                                            <tr>
                                                <td style="padding-bottom: 12px; font-size: 14px; font-weight: 600; color: #0f172a;">Payment Status:</td>
                                                <td align="right" style="padding-bottom: 12px; font-size: 14px; color: #16a34a; font-weight: 700;">✓ PAID</td>
                                            </tr>
                                            <tr>
                                                <td style="font-size: 14px; font-weight: 600; color: #0f172a;">Payment Date:</td>
                                                <td align="right" style="font-size: 14px; color: #475569;"><%= paymentDate %></td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <!-- Booking Details Section -->
                            <h3 style="margin: 0 0 15px 0; font-size: 16px; font-weight: 700; color: #0f172a; border-bottom: 2px solid #e2e8f0; padding-bottom: 8px;">Booking Details</h3>
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 30px;">
                                <tr>
                                    <td width="48%" style="background-color: #f8fafc; padding: 15px; border-radius: 6px; border: 1px solid #e2e8f0;">
                                        <p style="margin: 0 0 5px 0; font-size: 12px; color: #64748b; font-weight: 600; text-transform: uppercase;">Service / Item</p>
                                        <p style="margin: 0; font-size: 14px; color: #0f172a; font-weight: 700;"><%= serviceName %></p>
                                    </td>
                                    <td width="4%"></td>
                                    <td width="48%" style="background-color: #f8fafc; padding: 15px; border-radius: 6px; border: 1px solid #e2e8f0;">
                                        <p style="margin: 0 0 5px 0; font-size: 12px; color: #64748b; font-weight: 600; text-transform: uppercase;">Booking Date</p>
                                        <p style="margin: 0; font-size: 14px; color: #0f172a; font-weight: 700;"><%= bookingDate %></p>
                                    </td>
                                </tr>
                            </table>

                            <!-- Payment Summary -->
                            <h3 style="margin: 0 0 15px 0; font-size: 16px; font-weight: 700; color: #0f172a; border-bottom: 2px solid #e2e8f0; padding-bottom: 8px;">Payment Summary</h3>
                            
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #1e293b; color: #ffffff; border-radius: 8px; margin-bottom: 20px;">
                                <tr>
                                    <td style="padding: 25px; text-align: center;">
                                        <p style="margin: 0 0 5px 0; font-size: 14px; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px;">Total Amount Paid</p>
                                        <h2 style="margin: 0; font-size: 36px; font-weight: 800; color: #ffffff;"><%= amount.toFixed(2) %> BDT</h2>
                                    </td>
                                </tr>
                            </table>

                            <div style="background-color: #dcfce7; border: 1px solid #bbf7d0; color: #166534; padding: 15px; border-radius: 6px; text-align: center; font-weight: 600; margin-bottom: 30px;">
                                ✓ Payment Successfully Confirmed
                            </div>

                            <!-- Download Section -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top: 1px solid #e2e8f0; padding-top: 25px; text-align: center;">
                                <tr>
                                    <td>
                                        <p style="margin: 0 0 15px 0; font-size: 14px; color: #475569;">
                                            Your invoice PDF is attached to this email for your financial records.
                                        </p>
                                        <% if (invoiceUrl) { %>
                                            <a href="<%= invoiceUrl %>" style="display: inline-block; background-color: #3b82f6; color: #ffffff; padding: 12px 30px; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 14px;">Download Full PDF Invoice</a>
                                        <% } %>
                                    </td>
                                </tr>
                            </table>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="background-color: #f8fafc; padding: 30px 40px; text-align: center; border-top: 1px solid #e2e8f0;">
                            <p style="margin: 0 0 5px 0; font-size: 14px; font-weight: 700; color: #0f172a;">Jatra Automotive Services</p>
                            <p style="margin: 0 0 15px 0; font-size: 13px; color: #64748b;">The ultimate platform for vehicle rentals & repairs.</p>
                            
                            <p style="margin: 0 0 10px 0; font-size: 12px; color: #94a3b8;">
                                &copy; 2026 Jatra. All rights reserved.
                            </p>
                            <p style="margin: 0; font-size: 11px; color: #94a3b8;">
                                This is an automatically generated email. Please do not reply directly to this email.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>